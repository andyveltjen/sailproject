{% extends 'partials/base.html.twig' %}

{% set h = page.header %}
{% set current_lang = grav.language.getActive %}

{% block body %}

{# ── Top navigation ── #}
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur border-b border-slate-100 px-6">
    <div class="max-w-6xl mx-auto h-16 flex items-center justify-between">
        <a href="{{ base_url_absolute }}" class="flex items-center">
            <img src="{{ url('theme://images/logo.png') }}" alt="{{ site.title }}" class="h-9 w-auto">
        </a>
        <nav id="main-nav" class="hidden md:flex items-center gap-6 text-sm text-slate-600">
            <a href="#project" data-section="project" class="nav-anchor transition-colors hover:text-sail-600">{{ 'SAIL.NAV_PROJECT'|t }}</a>
            <a href="#wiki"    data-section="wiki"    class="nav-anchor transition-colors hover:text-sail-600">{{ 'SAIL.NAV_WIKI'|t }}</a>
            <a href="#knowledge-hub" data-section="knowledge-hub" class="nav-anchor transition-colors hover:text-sail-600">{{ 'SAIL.NAV_KNOWLEDGE_HUB'|t }}</a>
        </nav>
        <div class="hidden md:flex items-center gap-4">
            {# Taalwisselaar — root_url is altijd zonder taalprefix #}
            {% set root_url = grav.uri.rootUrl(true) %}
            {% set raw = page.rawRoute %}
            <div class="flex items-center gap-1.5 text-xs text-slate-400">
                <a href="{{ root_url }}{{ raw }}"
                   class="transition-colors {% if current_lang == 'nl' or not current_lang %}text-slate-700 font-semibold{% else %}hover:text-slate-600{% endif %}">NL</a>
                <span class="text-slate-300">·</span>
                <a href="{{ root_url }}/en{{ raw }}"
                   class="transition-colors {% if current_lang == 'en' %}text-slate-700 font-semibold{% else %}hover:text-slate-600{% endif %}">EN</a>
            </div>
            <a href="{{ base_url_absolute }}/wiki" class="inline-flex items-center gap-2 bg-sail-500 hover:bg-sail-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
                {{ 'SAIL.BTN_READ_WIKI'|t }} <i class="fa fa-arrow-right text-xs"></i>
            </a>
        </div>
    </div>
</header>

{# ── Hero ── #}
<section class="pt-32 pb-20 px-6 bg-gradient-to-br from-slate-50 via-sail-50 to-white">
    <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl">
            <div class="flex flex-wrap gap-2 mb-6">
                {% if h.hero.badge_research %}
                <span class="inline-flex items-center gap-2 bg-sail-100 text-sail-700 text-xs font-medium px-3 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-sail-500"></span>
                    {{ h.hero.badge_research }}
                </span>
                {% endif %}
                {% if h.hero.badge_topic %}
                <span class="inline-flex items-center bg-slate-100 text-slate-600 text-xs font-medium px-3 py-1 rounded-full">
                    {{ h.hero.badge_topic }}
                </span>
                {% endif %}
            </div>
            <h1 class="text-5xl font-bold text-slate-900 leading-tight mb-4">
                {{ page.title }}
            </h1>
            {% if h.hero.subtitle %}
            <p class="text-2xl text-sail-600 font-medium mb-6">{{ h.hero.subtitle }}</p>
            {% endif %}
            {% if h.hero.intro %}
            <p class="text-xl text-slate-500 leading-relaxed mb-10 max-w-2xl">{{ h.hero.intro }}</p>
            {% endif %}
            {% if h.hero.initiative %}
            <p class="text-sm text-slate-400 mb-8">
                {{ h.hero.initiative }}
                {% if h.hero.initiative_link_text %}
                <a href="{{ h.hero.initiative_link_url ?: 'https://research-expertise.ucll.be/en/expertcenters/education-development' }}"
                   target="_blank" rel="noopener noreferrer"
                   class="text-sail-500 hover:text-sail-600 underline underline-offset-2 transition-colors">{{ h.hero.initiative_link_text }}</a>
                {% endif %}
                {% if h.hero.initiative_of %}{{ h.hero.initiative_of }}{% endif %}
                {% if h.hero.initiative_org %}
                <a href="{{ h.hero.initiative_org_url ?: 'https://www.ucll.be/' }}"
                   target="_blank" rel="noopener noreferrer"
                   class="text-sail-500 hover:text-sail-600 underline underline-offset-2 transition-colors">{{ h.hero.initiative_org }}</a>
                {% endif %}
            </p>
            {% endif %}
            <div class="flex flex-wrap gap-4">
                {% if h.hero.cta_text %}
                <a href="{{ base_url_absolute }}/wiki" class="inline-flex items-center gap-2 bg-sail-500 hover:bg-sail-600 text-white font-medium px-6 py-3 rounded-xl transition-colors shadow-lg shadow-sail-200">
                    {{ h.hero.cta_text }} <i class="fa fa-arrow-right"></i>
                </a>
                {% endif %}
                {% if h.hero.second_cta_text %}
                <a href="#project" class="inline-flex items-center gap-2 text-slate-600 hover:text-slate-900 font-medium px-6 py-3 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors">
                    {{ h.hero.second_cta_text }}
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</section>

{# ── Project info ── #}
<section id="project" class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="text-3xl font-bold text-slate-900 mb-4">{{ h.project.title ?: 'Over het project' }}</h2>
                {% if h.project.description1 %}
                <p class="text-slate-500 leading-relaxed mb-4">{{ h.project.description1 }}</p>
                {% endif %}
                {% if h.project.description2 %}
                <p class="text-slate-500 leading-relaxed mb-6">{{ h.project.description2 }}</p>
                {% endif %}
                {% if h.project.checks %}
                <div class="flex flex-col gap-3">
                    {% for check in h.project.checks %}
                    <div class="flex items-start gap-3">
                        <span class="w-6 h-6 rounded-full bg-sail-100 flex items-center justify-center mt-0.5 flex-shrink-0">
                            <i class="fa fa-check text-sail-600 text-xs"></i>
                        </span>
                        <span class="text-slate-600 text-sm">{{ check.text }}</span>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% if h.project.stats %}
            <div class="grid grid-cols-2 gap-4">
                {% for stat in h.project.stats %}
                <div class="{% if loop.index is odd %}bg-slate-50{% else %}bg-sail-50{% endif %} rounded-2xl p-6">
                    <div class="text-3xl font-bold text-sail-600 mb-1">{{ stat.number }}</div>
                    <div class="text-sm text-slate-500">{{ stat.label }}</div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</section>

{# ── Wiki kaarten ── #}
{% if h.wiki_sections %}
<section id="wiki" class="py-20 px-6 bg-slate-50">
    <div class="max-w-6xl mx-auto">
        <div class="mb-12">
            <h2 class="text-3xl font-bold text-slate-900 mb-3">{{ h.wiki_sections.title ?: 'Wiki of Research' }}</h2>
            <p class="text-slate-500 max-w-xl">{{ h.wiki_sections.subtitle ?: 'Al ons onderzoek, gestructureerd en doorzoekbaar.' }}</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
            {% for section in h.wiki_sections.items %}
            <a href="{{ base_url_absolute }}{{ section.url }}" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-sail-300 hover:shadow-lg transition-all flex flex-col">
                <div class="w-10 h-10 rounded-xl bg-sail-100 flex items-center justify-center mb-4 group-hover:bg-sail-500 transition-colors">
                    <i class="fa {{ section.icon }} text-sail-600 group-hover:text-white transition-colors"></i>
                </div>
                <h3 class="font-semibold text-slate-900 mb-2">{{ section.title }}</h3>
                <p class="text-sm text-slate-500 mb-4">{{ section.description }}</p>
                <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs text-sail-500 font-medium">{{ current_lang == 'en' ? 'View Wiki' : 'Bekijk Wiki' }}</span>
                    <i class="fa fa-arrow-right text-xs text-sail-400 group-hover:translate-x-1 transition-transform"></i>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Knowledge Hub preview ── #}
<section id="knowledge-hub" class="py-20 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <div class="inline-flex items-center gap-2 bg-sail-100 text-sail-700 text-xs font-medium px-3 py-1 rounded-full mb-3">
                    <i class="fa fa-bookmark-o"></i> Knowledge Hub
                </div>
                <h2 class="text-3xl font-bold text-slate-900 mb-2">
                    {{ current_lang == 'en' ? 'Knowledge Hub' : 'Knowledge Hub' }}
                </h2>
                <p class="text-slate-500 max-w-xl">
                    {{ current_lang == 'en'
                        ? 'Curated sources on AI, education and professional development — collected and tagged by the SAIL team.'
                        : 'Gecureerde bronnen over AI, onderwijs en professionele ontwikkeling — verzameld en gelabeld door het SAIL-team.' }}
                </p>
            </div>
            <a href="{{ base_url_absolute }}/knowledge-hub"
               class="inline-flex items-center gap-2 text-sail-600 hover:text-sail-800 text-sm font-medium transition-colors whitespace-nowrap flex-shrink-0">
                {{ current_lang == 'en' ? 'View all sources' : 'Bekijk alle bronnen' }}
                <i class="fa fa-arrow-right text-xs"></i>
            </a>
        </div>

        {% if raindrop_preview is defined and raindrop_preview|length > 0 %}
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {% for item in raindrop_preview %}
            <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer"
               class="group bg-slate-50 rounded-2xl p-5 border border-slate-200 hover:border-sail-300 hover:shadow-lg transition-all flex flex-col">
                <div class="flex items-center gap-2 mb-3">
                    {% if item.domain %}
                    <img src="https://www.google.com/s2/favicons?domain={{ item.domain }}&sz=16"
                         alt="" class="w-4 h-4 rounded-sm opacity-60" loading="lazy">
                    <span class="text-xs text-slate-400 truncate">{{ item.domain }}</span>
                    {% endif %}
                </div>
                <h3 class="font-semibold text-slate-900 text-sm leading-snug mb-2 line-clamp-3 group-hover:text-sail-700 transition-colors">
                    {{ item.title }}
                </h3>
                {% if item.excerpt %}
                <p class="text-xs text-slate-500 line-clamp-2 mb-3 flex-1">{{ item.excerpt }}</p>
                {% else %}
                <div class="flex-1"></div>
                {% endif %}
                {% if item.tags|length > 0 %}
                <div class="flex flex-wrap gap-1 mt-auto pt-3 border-t border-slate-200">
                    {% for tag in item.tags|slice(0,2) %}
                    <span class="text-[10px] bg-sail-100 text-sail-600 px-2 py-0.5 rounded-full">{{ tag }}</span>
                    {% endfor %}
                </div>
                {% else %}
                <div class="mt-auto pt-3 border-t border-slate-200 flex items-center justify-between">
                    <span class="text-xs text-sail-500 font-medium">{{ current_lang == 'en' ? 'Read more' : 'Lees meer' }}</span>
                    <i class="fa fa-external-link text-xs text-sail-400 group-hover:translate-x-1 transition-transform"></i>
                </div>
                {% endif %}
            </a>
            {% endfor %}
        </div>
        {% else %}
        {# Placeholder als Raindrop nog niet geconfigureerd is #}
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {% for i in 1..4 %}
            <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100 h-40 animate-pulse">
                <div class="h-3 bg-slate-200 rounded w-2/3 mb-3"></div>
                <div class="h-3 bg-slate-200 rounded w-full mb-2"></div>
                <div class="h-3 bg-slate-200 rounded w-4/5"></div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <div class="mt-8 text-center">
            <a href="{{ base_url_absolute }}/knowledge-hub"
               class="inline-flex items-center gap-2 bg-sail-500 hover:bg-sail-600 text-white text-sm font-medium px-6 py-3 rounded-xl transition-colors">
                <i class="fa fa-bookmark-o"></i>
                {{ current_lang == 'en' ? 'Open Knowledge Hub' : 'Ga naar de Knowledge Hub' }}
                <i class="fa fa-arrow-right text-xs"></i>
            </a>
        </div>
    </div>
</section>

{# ── Tijdlijn ── #}
{% if h.timeline %}
<section id="tijdlijn" class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">{{ h.timeline.title ?: 'Tijdlijn' }}</h2>

        {# Desktop: 3-kolommen grid met vaste middenkolom voor de lijn en bollen #}
        <div class="hidden md:block">
            {% for phase in h.timeline.items %}
            <div class="grid items-center" style="grid-template-columns: 1fr 2rem 1fr;">

                {# Linkerkolom #}
                {% if loop.index is odd %}
                <div class="text-right pr-6">
                    <div class="font-semibold text-slate-900">{{ phase.name }}</div>
                    <div class="text-sm text-slate-400">{{ phase.period }}</div>
                </div>
                {% else %}
                <div class="text-right pr-6">
                    <span class="inline-block text-xs px-2.5 py-1 rounded-full
                        {% if phase.done %}bg-sail-100 text-sail-700{% else %}bg-slate-100 text-slate-500{% endif %}">
                        {{ phase.status }}
                    </span>
                </div>
                {% endif %}

                {# Middenkolom: bol + lijnstukjes #}
                <div class="flex flex-col items-center">
                    {% if not loop.first %}
                    <div class="w-px h-6 bg-slate-200"></div>
                    {% endif %}
                    <div class="w-8 h-8 rounded-full border-2 flex items-center justify-center flex-shrink-0
                        {% if phase.done %}bg-sail-500 border-sail-500{% else %}bg-white border-slate-300{% endif %}">
                        {% if phase.done %}<i class="fa fa-check text-white text-xs"></i>{% endif %}
                    </div>
                    {% if not loop.last %}
                    <div class="w-px h-6 bg-slate-200"></div>
                    {% endif %}
                </div>

                {# Rechterkolom #}
                {% if loop.index is odd %}
                <div class="pl-6">
                    <span class="inline-block text-xs px-2.5 py-1 rounded-full
                        {% if phase.done %}bg-sail-100 text-sail-700{% else %}bg-slate-100 text-slate-500{% endif %}">
                        {{ phase.status }}
                    </span>
                </div>
                {% else %}
                <div class="pl-6">
                    <div class="font-semibold text-slate-900">{{ phase.name }}</div>
                    <div class="text-sm text-slate-400">{{ phase.period }}</div>
                </div>
                {% endif %}

            </div>
            {% endfor %}
        </div>

        {# Mobiel: verticale lijst #}
        <div class="md:hidden relative">
            <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-200"></div>
            {% for phase in h.timeline.items %}
            <div class="relative mb-8 pl-14">
                <div class="absolute left-0 w-8 h-8 rounded-full border-2 flex items-center justify-center
                    {% if phase.done %}bg-sail-500 border-sail-500{% else %}bg-white border-slate-300{% endif %}">
                    {% if phase.done %}<i class="fa fa-check text-white text-xs"></i>{% endif %}
                </div>
                <div class="font-semibold text-slate-900">{{ phase.name }}</div>
                <div class="text-sm text-slate-400 mb-1">{{ phase.period }}</div>
                <span class="inline-block text-xs px-2.5 py-1 rounded-full
                    {% if phase.done %}bg-sail-100 text-sail-700{% else %}bg-slate-100 text-slate-500{% endif %}">
                    {{ phase.status }}
                </span>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Team ── #}
{% if h.team %}
<section id="team" class="py-20 px-6 bg-slate-50">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">{{ h.team.title ?: 'Het team' }}</h2>
        <div class="grid md:grid-cols-3 gap-6">
            {% for member in h.team.items %}
            <div class="bg-white rounded-2xl p-6 border border-slate-200 flex flex-col">
                {% if member.photo %}
                <div class="w-14 h-14 rounded-full overflow-hidden mb-4 flex-shrink-0">
                    <img src="{{ url('theme://images/' ~ member.photo) }}" alt="{{ member.name }}" class="w-full h-full object-cover">
                </div>
                {% else %}
                <div class="w-14 h-14 rounded-full bg-sail-100 flex items-center justify-center mb-4 flex-shrink-0">
                    <i class="fa fa-user text-sail-500 text-xl"></i>
                </div>
                {% endif %}
                <div class="font-semibold text-slate-900">{{ member.name }}</div>
                <div class="text-sm text-slate-400 mt-1">{{ member.role }}</div>
                {% if member.email or member.linkedin %}
                <div class="flex items-center gap-2 mt-4 pt-4 border-t border-slate-100">
                    {% if member.email %}
                    <a href="mailto:{{ member.email }}"
                       title="{{ member.email }}"
                       class="flex items-center gap-1.5 text-xs text-slate-400 hover:text-sail-600 transition-colors min-w-0">
                        <i class="fa fa-envelope-o flex-shrink-0"></i>
                        <span class="truncate">{{ member.email }}</span>
                    </a>
                    {% endif %}
                    {% if member.linkedin %}
                    <a href="{{ member.linkedin }}"
                       target="_blank" rel="noopener noreferrer"
                       title="LinkedIn"
                       class="ml-auto flex-shrink-0 w-7 h-7 flex items-center justify-center
                              rounded-md bg-slate-100 hover:bg-sail-100 hover:text-sail-600
                              text-slate-400 transition-colors">
                        <i class="fa fa-linkedin"></i>
                    </a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Scroll-to-top knop ── #}
<button id="scroll-top-btn"
        title="{{ current_lang == 'en' ? 'Back to top' : 'Terug naar boven' }}"
        class="fixed bottom-6 right-6 z-50 w-11 h-11 rounded-full bg-sail-500 hover:bg-sail-600 text-white shadow-lg flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none">
    <i class="fa fa-chevron-up text-sm"></i>
</button>

{# ── Footer ── #}
<footer id="contact" class="py-12 px-6 bg-slate-900 text-slate-400">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <img src="{{ url('theme://images/favicon.png') }}" alt="{{ site.title }}" class="w-7 h-7 rounded-lg">
            <span class="text-white font-medium">{{ site.title }}</span>
        </div>
        {% if h.contact.email %}
        <div class="text-sm">
            {{ 'SAIL.FOOTER_QUESTIONS'|t }} <a href="mailto:{{ h.contact.email }}" class="text-sail-400 hover:text-sail-300">{{ h.contact.email }}</a>
        </div>
        {% endif %}
        <div class="text-xs">{{ h.contact.footer_text ?: '© 2025 SAIL Project' }}</div>
    </div>
</footer>

<script>
(function () {
    // ── Actieve nav-sectie markeren ──────────────────────────────────────────
    const anchors  = document.querySelectorAll('#main-nav .nav-anchor');
    const sections = ['project', 'wiki', 'knowledge-hub'].map(id => document.getElementById(id)).filter(Boolean);

    function setActive(id) {
        anchors.forEach(a => {
            const isActive = a.dataset.section === id;
            a.classList.toggle('font-medium', isActive);
            a.classList.toggle('text-slate-900', isActive);
        });
    }

    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) setActive(entry.target.id);
        });
    }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });

    sections.forEach(s => observer.observe(s));

    // ── Scroll-to-top knop ───────────────────────────────────────────────────
    const btn = document.getElementById('scroll-top-btn');
    if (btn) {
        window.addEventListener('scroll', () => {
            btn.classList.toggle('opacity-0',        window.scrollY < 300);
            btn.classList.toggle('pointer-events-none', window.scrollY < 300);
            btn.classList.toggle('opacity-100',      window.scrollY >= 300);
        }, { passive: true });

        btn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }
})();
</script>

{% endblock %}
