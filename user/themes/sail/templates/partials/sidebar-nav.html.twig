{# ──────────────────────────────────────────────────────────────────────
   Sidebar navigatie — recursief, top-level detectie via parent route
────────────────────────────────────────────────────────────────────── #}

{% macro navloop(item, wiki_root_route) %}
    {% import _self as self %}
    {% for p in item.children.visible %}
        {% set is_active     = p.active ? true : false %}
        {% set is_parent     = p.activeChild ? true : false %}
        {% set has_children  = p.children.visible.count > 0 %}
        {% set child_count   = p.children.visible.count %}
        {% set is_open       = is_active or is_parent %}
        {% set is_top        = (p.parent.rawRoute == wiki_root_route) %}

        <li>
            {% if is_top and has_children %}
                {# ── Top-level MÉT kinderen: volledige rij toggle + link ── #}
                <div class="group relative rounded-md
                            {% if is_open %}bg-slate-50{% endif %}
                            transition-colors cursor-pointer"
                     onclick="sailNavToggle(this)">

                    <div class="flex items-center gap-1 py-1.5">

                        {# Bullet — zelfde als top-level zonder kinderen #}
                        <span class="w-5 flex-shrink-0 flex items-center justify-center">
                            <i class="fa text-[8px]
                                      {% if is_open %}fa-square text-sail-500{% else %}fa-square-o text-slate-300 group-hover:text-slate-400{% endif %}"></i>
                        </span>

                        {# Label — navigatie staat los van toggle #}
                        <a href="{{ p.url }}"
                           onclick="event.stopPropagation()"
                           class="flex-1 py-1.5 px-2 text-sm line-clamp-2 transition-colors
                                  {% if is_active %}text-sail-700 font-semibold
                                  {% elseif is_parent %}text-slate-700 font-medium
                                  {% else %}text-slate-500 group-hover:text-slate-700{% endif %}">
                            {{ p.menu }}
                        </a>

                        {# Badge: aantal sub-pagina's, verdwijnt als open #}
                        <span class="flex-shrink-0 text-[10px] font-medium rounded-full px-1.5 py-0.5
                                     leading-none select-none transition-all duration-200
                                     {% if is_open %}opacity-0{% else %}opacity-100 bg-slate-100 text-slate-400 group-hover:bg-sail-100 group-hover:text-sail-500{% endif %}">
                            {{ child_count }}
                        </span>

                    </div>
                </div>

                {# Kinderen #}
                <ul class="mt-0.5 space-y-0.5 ml-4 pl-2.5 border-l-2 border-slate-100
                           {% if not is_open %}hidden{% endif %}"
                    data-nav-children>
                    {{ self.navloop(p, wiki_root_route) }}
                </ul>

            {% elseif is_top %}
                {# ── Top-level ZONDER kinderen ── #}
                <div class="flex items-center gap-1">
                    <span class="w-5 flex-shrink-0 flex items-center justify-center">
                        <i class="fa text-[8px]
                                  {% if is_active %}fa-square text-sail-500{% else %}fa-square-o text-slate-300{% endif %}"></i>
                    </span>
                    <a href="{{ p.url }}"
                       class="flex-1 py-1.5 px-2 rounded-md text-sm transition-colors line-clamp-2
                              {% if is_active %}bg-sail-50 text-sail-700 font-semibold
                              {% else %}text-slate-500 hover:text-slate-700 hover:bg-slate-50{% endif %}">
                        {{ p.menu }}
                    </a>
                </div>

            {% else %}
                {# ── Sub-pagina ── #}
                <div class="flex items-center gap-0.5">
                    <span class="w-4 flex-shrink-0 flex items-center justify-center">
                        <i class="fa text-[7px]
                                  {% if is_active %}fa-circle text-sail-400{% else %}fa-minus text-slate-200{% endif %}"></i>
                    </span>
                    <a href="{{ p.url }}"
                       class="flex-1 py-1.5 px-2 rounded-md text-sm transition-colors line-clamp-2
                              {% if is_active %}text-sail-600 font-medium
                              {% else %}text-slate-400 hover:text-slate-600 hover:bg-slate-50{% endif %}">
                        {{ p.menu }}
                    </a>
                </div>

                {% if has_children %}
                <ul class="mt-0.5 space-y-0.5 ml-4 pl-2 border-l border-slate-100
                           {% if not is_open %}hidden{% endif %}"
                    data-nav-children>
                    {{ self.navloop(p, wiki_root_route) }}
                </ul>
                {% endif %}

            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}

{% import _self as macro %}

{% set search_active = config.site.search.active is defined ? config.site.search.active : true %}
{% set current_lang  = grav.language.getActive ?: 'nl' %}
{% set root_url      = grav.uri.rootUrl(true) %}

<nav class="px-3 pb-3 overflow-y-auto flex-1">
    <div class="flex items-center gap-2 px-3 mb-2 mt-3">
        <span class="text-[10px] font-semibold text-sail-500 uppercase tracking-widest">{{ 'SAIL.WIKI_CONTENT'|t }}</span>
        <span class="flex-1 h-px bg-sail-100"></span>
    </div>
    <ul class="space-y-0.5">
        {% set wiki_page = page.find('/wiki') %}
        {% if wiki_page %}
            {{ macro.navloop(wiki_page, wiki_page.rawRoute) }}
        {% else %}
            {{ macro.navloop(pages, '/') }}
        {% endif %}
    </ul>
</nav>

{# ── AI Zoekfunctie ──────────────────────────────────────────────────────── #}
{% if search_active %}
<div class="px-3 pb-5 border-t border-slate-100 pt-3 mt-1"
     data-search-url="{{ root_url }}/wiki-search"
     data-lang="{{ current_lang }}">

    <div class="px-1 mb-2.5">
        <div class="flex items-center gap-1.5 text-sail-600 font-semibold text-sm">
            <i class="fa fa-magic text-[12px]"></i>
            {{ current_lang == 'en' ? 'SAIL Assistant' : 'SAIL Assistent' }}
        </div>
        <div class="text-xs text-slate-400 mt-0.5 pl-0.5">
            {{ current_lang == 'en' ? 'Fed by the Wiki of Research' : 'Gevoed door de Wiki of Research' }}
        </div>
    </div>

    <div class="relative">
        <input type="text"
               id="sail-search-input"
               placeholder="{{ current_lang == 'en' ? 'e.g. What is the impact of AI on learning?' : 'bv. Wat is de impact van AI op leren?' }}"
               onkeydown="if(event.key==='Enter') sailSearch()"
               class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg
                      px-3 py-2 pr-8 focus:outline-none focus:border-sail-300 focus:bg-white
                      transition-colors placeholder-slate-300 text-slate-700">
        <button onclick="sailSearch()"
                title="{{ current_lang == 'en' ? 'Search' : 'Zoeken' }}"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-300
                       hover:text-sail-500 transition-colors">
            <i class="fa fa-paper-plane-o text-sm"></i>
        </button>
    </div>

    <div id="sail-search-results"
         class="hidden mt-2.5 text-sm text-slate-600 bg-sail-50 border border-sail-100
                rounded-lg p-3 leading-relaxed max-h-52 overflow-y-auto"></div>
</div>
{% endif %}
